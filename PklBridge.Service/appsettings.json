{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "PklBridge": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "PklBridge": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pkl-bridge-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "BridgeSettings": {
    "PipeName": "pkl_serial",
    "RealComPort": "COM2",
    "Serial": {
      "BaudRate": 19200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "Handshake": "None",
      "ReadTimeout": 5000,
      "WriteTimeout": 5000,
      "DtrEnable": false,
      "RtsEnable": false
    },
    "BufferSize": 4096,
    "TimeoutMs": 5000,
    "EnableHardwareBridge": false,
    "LogAllTraffic": true
  },
  "VidaApi": {
    "BaseUrl": "https://vida.hospital.local/api",
    "ResultEndpoint": "/exams/results",
    "PatientEndpoint": "/patients",
    "AuthEndpoint": "/auth/token",
    "ApiKey": "",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "EnableCircuitBreaker": true,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeoutMinutes": 5
  },
  "AstmSettings": {
    "ValidateChecksum": true,
    "StrictParsing": false,
    "FieldSeparator": "|",
    "ComponentSeparator": "^",
    "RepeatSeparator": "\\",
    "EscapeSeparator": "&",
    "DateTimeFormat": "yyyyMMddHHmmss",
    "SupportedRecordTypes": ["H", "P", "O", "R", "Q", "L"]
  },
  "ProcessingSettings": {
    "MaxBatchSize": 100,
    "BatchTimeoutSeconds": 300,
    "MaxConcurrentProcessing": 5,
    "EnableDeduplication": true,
    "DeduplicationWindowMinutes": 60,
    "EnableMessageQueue": true,
    "QueueMaxSize": 1000
  },
  "HealthCheckSettings": {
    "EnableHealthChecks": true,
    "CheckIntervalSeconds": 30,
    "PipeConnectionTimeoutMs": 5000,
    "SerialPortTimeoutMs": 3000,
    "ApiTimeoutMs": 10000,
    "HealthCheckEndpoint": "/health"
  }
}
