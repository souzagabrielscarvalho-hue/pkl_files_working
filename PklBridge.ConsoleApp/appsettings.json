{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "BridgeSettings": {
    "PipeName": "pkl_serial",
    "RealComPort": "COM2",
    "EnableHardwareBridge": false,
    "EnableTcpServer": true,
    "TcpPort": 8081,
    "LogAllTraffic": true,
    "Serial": {
      "BaudRate": 19200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "Handshake": "None",
      "ReadTimeout": 5000,
      "WriteTimeout": 5000,
      "DtrEnable": false,
      "RtsEnable": false
    }
  },
  "VidaApi": {
    "BaseUrl": "https://internal_laboratory.siqueira.vidaexame.com",
    "ResultEndpoint": "/exams/results",
    "PatientEndpoint": "/patients",
    "IntegrationEndpoint": "/api/integration/pkl-125",
    "FranchiseCredentialId": "88cf9273-5044-47f4-b8f6-01160345a190",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "EnableCircuitBreaker": true,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeoutMinutes": 2
  },
  "AstmSettings": {
    "FieldSeparator": "|",
    "ComponentSeparator": "^",
    "RepeatSeparator": "\\",
    "EscapeCharacter": "&",
    "DateTimeFormat": "yyyyMMddHHmmss",
    "ValidateChecksum": false,
    "StrictParsing": false,
    "SupportedRecordTypes": [ "H", "P", "O", "R", "Q", "L" ]
  },
  "ProcessingSettings": {
    "MaxConcurrentProcessing": 5,
    "BatchTimeoutSeconds": 300,
    "MaxBatchSize": 100,
    "EnableDeduplication": true,
    "DeduplicationWindowMinutes": 30,
    "RetryDelayMs": 5000
  },
  "HealthCheckSettings": {
    "IntervalMinutes": 2,
    "TimeoutSeconds": 30,
    "EnableDetailedChecks": true
  }
}
